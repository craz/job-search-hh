JOB_SEARCH_HH_LOG_LEVEL=INFO
JOB_SEARCH_HH_EXTERNAL_WRITES_ENABLED=false
JOB_SEARCH_HH_APPLY_LIMIT=1
CORE_API_URL=http://127.0.0.1:8000
JOB_SEARCH_HH_API_URL=https://api.hh.ru
JOB_SEARCH_HH_TIMEOUT_SECONDS=20
JOB_SEARCH_HH_USER_AGENT=job-search-hh/0.1 (+local; read-only)
HH_STATE_DIR=.hh-state
HH_PROFILE_DIR=.hh-profile
# OAuth application credentials (never commit real values)
JOB_SEARCH_HH_CLIENT_ID=
JOB_SEARCH_HH_CLIENT_SECRET=
JOB_SEARCH_HH_REDIRECT_URI=http://127.0.0.1:8767/oauth/callback
# Optional runtime override; prefer auth set-token / exchange-code into state volume
# JOB_SEARCH_HH_ACCESS_TOKEN=

